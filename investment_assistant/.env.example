# Database: use a dedicated PostgreSQL role with SELECT-only grants.
DATABASE_URL=postgresql+psycopg2://investment_assistant_ro:CHANGE_ME@postgres:5432/financas_db
ASSISTANT_USER_ID=1

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=
MCP_PUBLIC_URL=https://investment-assistant.example.com/mcp/
MCP_BEARER_TOKEN=GENERATE_A_LONG_RANDOM_SECRET

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=GENERATE_ANOTHER_LONG_RANDOM_SECRET
TELEGRAM_ALLOWED_CHAT_IDS=

# Runtime
LOG_LEVEL=INFO
